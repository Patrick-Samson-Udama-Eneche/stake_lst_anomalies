# Data paths
INPUT_DATA_PATH=./data/inputs
OUTPUT_DATA_PATH=./data/outputs

# Google Earth Engine Configuration
# IMPORTANT: Store the actual service account JSON file OUTSIDE the repository
# or use the default location (ensure it's in .gitignore)
GEE_SERVICE_JSON=/path/to/your/gee_service_account.json
GEE_PROJECT_ID=your-gee-project-id

# Processing parameters
RANDOM_STATE=42
N_JOBS=-1

# Model parameters
TEST_SIZE=0.2
CV_FOLDS=5

# Visualization
FIGURE_DPI=300
PLOT_STYLE=seaborn
